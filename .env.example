# ==============================================================================
# KASIRAKUN UMKM — PRODUCTION ENVIRONMENT TEMPLATE (VERCEL + NEON + S3 + BETTER AUTH)
# ==============================================================================
# Salin file ini ke `.env` untuk lokal, atau masukkan di Vercel Project Settings
# -> Environment Variables. Semua kunci rahasia juga dapat dikelola terenkripsi
# (AES-256-GCM) langsung dari menu: Master Admin -> Pengaturan API & Secret Key.
# ==============================================================================

# --- 1. Database PostgreSQL (Neon Serverless / Google Cloud SQL / Supabase) ---
# Gunakan Pooled Connection String Neon untuk runtime Serverless Vercel
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Gunakan Direct (Non-Pooler) Connection String Neon untuk `prisma db push` / migrasi
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- 2. Better Auth & Google OAuth ---
# Generate random 32-byte hex: `openssl rand -hex 32`
BETTER_AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- 3. Universal S3 Object Storage (Neon Storage / Cloudflare R2 / Biznet Gio NEO) ---
# Contoh Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Contoh Biznet Gio NEO: https://nos.wjv-1.neo.id
S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="kasirakun-assets"
S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
S3_PUBLIC_URL="https://cdn.kasirakun.id"
S3_FORCE_PATH_STYLE="false"

# --- 4. Enkripsi Kredensial Payment Gateway (AES-256-GCM) ---
# Generate random 32-byte hex: `openssl rand -hex 32`
PAYMENT_KEY_ENCRYPTION_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"

# --- 5. Add-On Landing Page UMKM (/toko/[slug] & Subdomain) ---
NEXT_PUBLIC_LANDING_URL_MODE="SUBPATH"
NEXT_PUBLIC_ROOT_DOMAIN=""
VITE_LANDING_URL_MODE="SUBPATH"
VITE_ROOT_DOMAIN=""

# --- 6. Add-On Opsional (0 Token AI untuk Seluruh Fitur Inti) ---
# Diperlukan hanya jika mengaktifkan Add-On Asisten AI
GEMINI_API_KEY=""
# Diperlukan hanya jika mengaktifkan Add-On WhatsApp Gateway otomatis (Fonnte)
FONNTE_TOKEN=""
FONNTE_COUNTRY_CODE="62"
