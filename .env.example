# ==============================================================================
# KASIRAKUN UMKM — KONFIGURASI ENVIRONMENT (OPSIONAL / ZERO-CONFIG START)
# ==============================================================================
# Seluruh variabel di bawah ini OPSIONAL dan sengaja dikomentari agar aplikasi
# langsung berjalan/deploy tanpa perlu mengisi secret satu per satu di awal.
#
# Anda dapat mengisi dan mengaktifkan SEMUA kunci di bawah kapan saja secara
# terenkripsi (AES-256-GCM) langsung dari menu:
#   Master Admin -> Pengaturan API & Secret Key
# (otomatis tersinkron ke runtime server tanpa perlu edit kode atau restart).
# ==============================================================================

# --- AI Add-On (Opsional, khusus tenant Add-On Asisten AI; paket inti 0 token AI) ---
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- URL Publik & Subdomain Landing Page UMKM ---
# APP_URL="https://kasirakun.id"
# LANDING_URL_MODE="SUBPATH" # Options: SUBPATH | SUBDOMAIN
# ROOT_DOMAIN="" # Contoh saat migrasi domain kustom: kasirakun.id
# VITE_LANDING_URL_MODE="SUBPATH"
# VITE_ROOT_DOMAIN=""
# NEXT_PUBLIC_LANDING_URL_MODE="SUBPATH"
# NEXT_PUBLIC_ROOT_DOMAIN=""

# --- PostgreSQL Eksternal (Supabase PostgreSQL / Neon Serverless / Cloud SQL) ---
# DB_PROVIDER="CURRENT_LOCAL_FIRESTORE" # Options: CURRENT_LOCAL_FIRESTORE | SUPABASE_POSTGRES | NEON_POSTGRES
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# --- Object Storage (Supabase Storage / Cloudflare R2 S3-Compatible) ---
# STORAGE_PROVIDER="CURRENT_LOCAL_FIRESTORE" # Options: CURRENT_LOCAL_FIRESTORE | SUPABASE_STORAGE | CLOUDFLARE_R2
# SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# SUPABASE_STORAGE_BUCKET="kasirakun-assets"
# R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
# R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
# R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
# R2_BUCKET_NAME="kasirakun-assets"
# R2_PUBLIC_BASE_URL="https://cdn.kasirakun.id"

# --- WhatsApp Gateway Add-On (Fonnte) & Keamanan Vault ---
# AUTO_SYNC_ON_BOOT="true"
# FONNTE_TOKEN="YOUR_FONNTE_DEVICE_TOKEN"
# FONNTE_COUNTRY_CODE="62"
# PAYMENT_CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"
