# GEMINI_API_KEY: Required ONLY if tenant enables optional ADDON_AI_ASSISTANT (+Rp35k/bln).
# All core plans (BASIC/PRO/EXPERT) and payment auto-verification use 0 AI tokens.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of this application (Cloud Run / Vercel / Custom Domain).
APP_URL="MY_APP_URL"

# ==============================================================================
# POSTGRESQL MIGRATION TARGET (Supabase PostgreSQL / Neon Serverless Postgres)
# Configure these when scaling & switching via Master Admin -> Migrasi DB & Storage
# ==============================================================================
DB_PROVIDER="CURRENT_LOCAL_FIRESTORE" # Options: CURRENT_LOCAL_FIRESTORE | SUPABASE_POSTGRES | NEON_POSTGRES
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ==============================================================================
# OBJECT STORAGE TARGET (Supabase Storage / Cloudflare R2 S3-Compatible)
# ==============================================================================
STORAGE_PROVIDER="CURRENT_LOCAL_FIRESTORE" # Options: CURRENT_LOCAL_FIRESTORE | SUPABASE_STORAGE | CLOUDFLARE_R2
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="kasirakun-assets"

R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="kasirakun-assets"
R2_PUBLIC_BASE_URL="https://cdn.kasirakun.id"

# ==============================================================================
# SINKRONISASI OTOMATIS & PENGATURAN SECRET (DIISI NANTI DI SERVER HOSTING)
# Anda tidak perlu mengisi nilai di bawah sekarang — sistem otomatis berjalan
# memakai database bawaan sampai DATABASE_URL / R2 / FONNTE_TOKEN diisi di server.
# ==============================================================================
AUTO_SYNC_ON_BOOT="true"

# ==============================================================================
# WHATSAPP GATEWAY ADD-ON (Fonnte — Rp66.000/bln Add-On)
# Used server-side by POST /api/whatsapp/fonnte/send (never exposed to browser)
# ==============================================================================
FONNTE_TOKEN="YOUR_FONNTE_DEVICE_TOKEN"
FONNTE_COUNTRY_CODE="62"

# ==============================================================================
# ENKRIPSI KREDENSIAL PAYMENT GATEWAY UMKM (AES-256-GCM)
# Digunakan untuk mengenkripsi Server Key / API Key Midtrans, Duitku & Tripay
# ==============================================================================
PAYMENT_CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_RANDOM_HEX_SECRET"

