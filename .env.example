# ==============================================================================
# KASIRAKUN UMKM — ENVIRONMENT VARIABLES (VERCEL + NEON + MIDTRANS + FONNTE)
# ==============================================================================
# Fokus 14 variabel inti saja agar rapi dan siap online di Vercel:
# 1. Neon PostgreSQL Database (2 variabel)
# 2. Better Auth di Neon & Akun Master Admin (4 variabel)
# 3. Neon Object Storage S3-Compatible (5 variabel)
# 4. Pembayaran Master Admin — Midtrans (2 variabel)
# 5. WhatsApp Otomatis — Fonnte (1 variabel)
# ==============================================================================

# --- 1. NEON POSTGRESQL DATABASE (WAJIB) ---
# Ambil di Neon Console -> Connection Details -> Pooled connection (-pooler)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Ambil di Neon Console -> Connection Details -> matikan Pooled (Direct URL untuk Prisma)
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- 2. BETTER AUTH DI NEON & MASTER ADMIN (WAJIB) ---
# Buat 64 hex acak dengan: openssl rand -hex 32
# (Otomatis juga mengamankan sesi API Vercel, enkripsi AES-256 Midtrans, & webhook)
BETTER_AUTH_SECRET="REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL_RAND_HEX_32"
# URL HTTPS aplikasi Vercel Anda tanpa garis miring akhir (contoh: https://kasirakun-umkm.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
# Akun login Master Admin Anda di produksi
MASTER_ADMIN_EMAIL="master@kasirakun.id"
MASTER_ADMIN_PASSWORD="GantiPasswordMasterKuat2026!"

# --- 3. NEON OBJECT STORAGE — S3 COMPATIBLE (WAJIB UNTUK UPLOAD FOTO/LOGO DI VERCEL) ---
# Ambil dari Neon Console -> Project / Branch -> Object Storage (S3 Credentials)
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-1.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="nak_live_xxxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxxx"
S3_BUCKET="kasirakun-assets"

# --- 4. PAYMENT GATEWAY MASTER ADMIN: MIDTRANS (WAJIB) ---
# Ambil di dashboard.midtrans.com -> Settings -> Access Keys
# Gunakan prefix SB-Mid-... untuk Sandbox atau Mid-... untuk Production
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- 5. WHATSAPP OTOMATIS: FONNTE (WAJIB) ---
# Ambil di md.fonnte.com -> Device -> Token (kode negara otomatis 62 / Indonesia)
FONNTE_TOKEN=""
