// KasirAkun UMKM — Complete PostgreSQL / Google Cloud SQL Prisma Schema (Backward-Compatible Additive Update)
// Uses NUMERIC(19, 4) for all monetary, stock, and tax fields (zero floating-point arithmetic)
// Supports 6 UMKM Verticals, Multi-Branch/Warehouse, 3-Step Stock Transfers, Supplier PO, Blind Opname,
// Boarding House (Kost), Agro/Livestock Batch WIP, Cashier Shifts & Anti-Fraud Audit Log,
// Hybrid Subscription Plans + Add-Ons, AI Assistant Quota/Cache, and Master Demo Control.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BusinessVertical {
  WARUNG_SEMBAKO
  TOKO_RETAIL
  TOKO_FASHION
  TOKO_BANGUNAN
  MANUFAKTUR_KECIL
  BARBERSHOP
  SALON_KECANTIKAN
  SPA_WELLNESS
  BARBERSHOP_SALON
  KEDAI_MAKAN
  RESTORAN
  BAKERY_CATERING
  LAUNDRY
  CUCI_KENDARAAN
  RENTAL_KENDARAAN
  SEWA_LAPANGAN
  PET_SHOP
  BIMBEL_KURSUS_GYM
  HOMESTAY_VILLA
  SEWA_GARASI
  FREELANCE
  KOST_KONTRAKAN
  PETERNAKAN_PERTANIAN

  @@map("business_vertical")
}

enum TaxEntityType {
  WP_OP
  PT_PERORANGAN
  CV_FIRMA
  PT_BIASA

  @@map("tax_entity_type")
}

enum MemberRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  ACCOUNTANT

  @@map("member_role")
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_category")
}

enum BalanceSide {
  DEBIT
  CREDIT

  @@map("balance_side")
}

enum BranchType {
  OUTLET
  CENTRAL_WAREHOUSE

  @@map("branch_type")
}

enum BoardingRoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE

  @@map("boarding_room_status")
}

enum AgroBatchKind {
  TERNAK
  TANAMAN

  @@map("agro_batch_kind")
}

enum AgroBatchStatus {
  ACTIVE
  HARVESTED

  @@map("agro_batch_status")
}

enum StockTransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  CANCELLED

  @@map("stock_transfer_status")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum OpnameStatus {
  IN_PROGRESS
  APPROVED
  CANCELLED

  @@map("opname_status")
}

enum GlobalDemoMode {
  PUBLIC_INSTANT
  APPOINTMENT_APPROVAL

  @@map("global_demo_mode")
}

enum DemoRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("demo_request_status")
}

enum PaymentGatewayProvider {
  SIMULATOR
  MIDTRANS
  MANUAL_ONLY

  @@map("payment_gateway_provider")
}

enum GatewayEnvironment {
  SANDBOX
  PRODUCTION

  @@map("gateway_environment")
}

enum FeeBearer {
  MERCHANT
  CUSTOMER

  @@map("fee_bearer")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique @db.VarChar(255)
  passwordHash         String?               @map("password_hash")
  name                 String                @default("") @db.VarChar(150)
  fullName             String                @default("") @map("full_name") @db.VarChar(150)
  emailVerified        Boolean               @default(false) @map("email_verified")
  image                String?               @db.Text
  phone                String?               @db.VarChar(30)
  isSuperAdmin         Boolean               @default(false) @map("is_super_admin")
  accountStatus        String                @default("ACTIVE") @map("account_status") @db.VarChar(20)
  maxTenantsAllowed    Int                   @default(3) @map("max_tenants_allowed")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz()
  memberships          TenantMembership[]
  subscriptionInvoices SubscriptionInvoice[]
  sessions             Session[]
  authAccounts         AuthAccount[]

  @@map("users")
}

model SubscriptionInvoice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber   String    @unique @map("invoice_number") @db.VarChar(64)
  userId          String?   @map("user_id") @db.Uuid
  customerEmail   String    @map("customer_email") @db.VarChar(255)
  planCode        String    @default("BASIC") @map("plan_code") @db.VarChar(30)
  billingCycle    String    @default("MONTHLY") @map("billing_cycle") @db.VarChar(20)
  selectedModules Json      @default("[]") @map("selected_modules") @db.JsonB
  subtotalAmount  Decimal   @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  dppNilaiLain    Decimal   @default(0) @map("dpp_nilai_lain") @db.Decimal(19, 4)
  ppnAmount       Decimal   @default(0) @map("ppn_amount") @db.Decimal(19, 4)
  grandTotal      Decimal   @default(0) @map("grand_total") @db.Decimal(19, 4)
  paymentMethod   String    @default("QRIS_DYNAMIC") @map("payment_method") @db.VarChar(30)
  paymentStatus   String    @default("PENDING_PAYMENT") @map("payment_status") @db.VarChar(30)
  gatewayRefId    String?   @unique @map("gateway_ref_id") @db.VarChar(120)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("subscription_invoices")
}

model Tenant {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                  @db.VarChar(150)
  slug                   String                  @unique @db.VarChar(100)
  vertical               BusinessVertical
  taxEntity              TaxEntityType           @default(WP_OP) @map("tax_entity")
  isPkp                  Boolean                 @default(false) @map("is_pkp")
  npwp16                 String?                 @map("npwp_16") @db.VarChar(16)
  nitku22                String?                 @map("nitku_22") @db.VarChar(22)
  address                String?
  logoUrl                String?                 @map("logo_url")
  receiptFooter          String?                 @default("Terima kasih atas kunjungan Anda!") @map("receipt_footer")
  planCode               String                  @default("BASIC") @map("plan_code") @db.VarChar(30)
  settings               Json                    @default("{}") @db.JsonB
  verticalOpsJson        Json                    @default("{}") @map("vertical_ops_json") @db.JsonB
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz()

  memberships            TenantMembership[]
  subscriptions          TenantSubscription[]
  branches               Branch[]
  branchStocks           BranchStock[]
  stockTransfers         StockTransfer[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  stockOpnameSessions    StockOpnameSession[]
  customFieldDefinitions CustomFieldDefinition[]
  categories             Category[]
  products               Product[]
  productRecipes         ProductRecipe[]
  inventoryMovements     InventoryMovement[]
  restaurantTables       RestaurantTable[]
  orders                 Order[]
  salesReturns           SalesReturn[]
  payments               Payment[]
  operationalExpenses    OperationalExpense[]
  fixedAssets            FixedAsset[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  boardingRooms          BoardingRoom[]
  boardingTenants        BoardingTenant[]
  boardingInvoices       BoardingInvoice[]
  agroBatches            AgroBatch[]
  cashierShifts          CashierShift[]
  auditLogs              AuditLog[]
  promotions             Promotion[]
  priceTiers             PriceTier[]
  customers              Customer[]
  aiUsageLogs            AiUsageLog[]
  aiInsightCaches        AiInsightCache[]
  paymentConfig          TenantPaymentConfig?
  paymentTransactions    PaymentTransaction[]
  paymentAssistRequests  PaymentSetupAssistanceRequest[]
  settlementBatches      SettlementBatch[]
  landingPage            TenantLandingPage?
  landingPageAssistanceRequests LandingPageAssistanceRequest[]
  contractTemplates      ContractTemplate[]
  digitalContracts       DigitalContract[]

  @@map("tenants")
}

model Branch {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  code                String               @db.VarChar(32)
  name                String               @db.VarChar(120)
  branchType          BranchType           @default(OUTLET) @map("branch_type")
  address             String?
  phone               String?              @db.VarChar(30)
  nitku22             String?              @map("nitku_22") @db.VarChar(22)
  isDefault           Boolean              @default(false) @map("is_default")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchStocks        BranchStock[]
  outgoingTransfers   StockTransfer[]      @relation("SourceBranch")
  incomingTransfers   StockTransfer[]      @relation("DestinationBranch")
  purchaseOrders      PurchaseOrder[]
  opnameSessions      StockOpnameSession[]
  orders              Order[]
  cashierShifts       CashierShift[]
  operationalExpenses OperationalExpense[]
  journalEntries      JournalEntry[]
  paymentTransactions PaymentTransaction[]
  landingPages        TenantLandingPage[]

  @@unique([tenantId, code])
  @@index([tenantId], map: "idx_branches_tenant")
  @@index([tenantId, isActive], map: "idx_branches_tenant_active")
  @@map("branches")
}

model BranchStock {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  branchId             String   @map("branch_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  stockQty             Decimal  @default(0) @map("stock_qty") @db.Decimal(19, 4)
  minStockAlert        Decimal  @default(0) @map("min_stock_alert") @db.Decimal(19, 4)
  sellingPriceOverride Decimal? @map("selling_price_override") @db.Decimal(19, 4)
  movingAvgCost        Decimal  @default(0) @map("moving_avg_cost") @db.Decimal(19, 4)
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId, branchId], map: "idx_branch_stocks_tenant_branch")
  @@index([tenantId, productId], map: "idx_branch_stocks_tenant_product")
  @@index([tenantId, branchId, updatedAt(sort: Desc)], map: "idx_branch_stocks_tenant_branch_sync")
  @@map("branch_stocks")
}

model StockTransfer {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  transferNumber      String              @map("transfer_number") @db.VarChar(50)
  sourceBranchId      String              @map("source_branch_id") @db.Uuid
  destinationBranchId String              @map("destination_branch_id") @db.Uuid
  status              StockTransferStatus @default(REQUESTED)
  notes               String?
  requestedBy         String?             @map("requested_by") @db.VarChar(120)
  shippedAt           DateTime?           @map("shipped_at") @db.Timestamptz()
  receivedAt          DateTime?           @map("received_at") @db.Timestamptz()
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceBranch        Branch              @relation("SourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch   Branch              @relation("DestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  items               StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, status], map: "idx_stock_transfers_tenant_status")
  @@index([tenantId, sourceBranchId, status], map: "idx_stock_transfers_source_status")
  @@index([tenantId, destinationBranchId, status], map: "idx_stock_transfers_dest_status")
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_stock_transfers_tenant_date")
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockTransferId String        @map("stock_transfer_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  requestedQty    Decimal       @map("requested_qty") @db.Decimal(19, 4)
  shippedQty      Decimal       @default(0) @map("shipped_qty") @db.Decimal(19, 4)
  receivedQty     Decimal       @default(0) @map("received_qty") @db.Decimal(19, 4)
  damagedQty      Decimal       @default(0) @map("damaged_qty") @db.Decimal(19, 4)
  unitCostAtShip  Decimal       @default(0) @map("unit_cost_at_ship") @db.Decimal(19, 4)

  transfer        StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockTransferId], map: "idx_stock_transfer_items_transfer")
  @@index([productId], map: "idx_stock_transfer_items_product")
  @@map("stock_transfer_items")
}

model Supplier {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  name           String          @db.VarChar(150)
  phone          String?         @db.VarChar(30)
  address        String?
  paymentTermDays Int            @default(0) @map("payment_term_days")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([tenantId], map: "idx_suppliers_tenant")
  @@map("suppliers")
}

model PurchaseOrder {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  branchId          String?             @map("branch_id") @db.Uuid
  supplierId        String?             @map("supplier_id") @db.Uuid
  poNumber          String              @map("po_number") @db.VarChar(50)
  status            PurchaseOrderStatus @default(DRAFT)
  paymentType       String              @default("TUNAI") @map("payment_type") @db.VarChar(20)
  dueDate           DateTime?           @map("due_date") @db.Date
  subtotalAmount    Decimal             @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  landedCostShipping Decimal            @default(0) @map("landed_cost_shipping") @db.Decimal(19, 4)
  grandTotal        Decimal             @default(0) @map("grand_total") @db.Decimal(19, 4)
  amountPaid        Decimal             @default(0) @map("amount_paid") @db.Decimal(19, 4)
  notes             String?
  receiptImageUrl   String?             @map("receipt_image_url")
  receivedAt        DateTime?           @map("received_at") @db.Timestamptz()
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items             PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, branchId], map: "idx_po_tenant_branch")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  orderedQty      Decimal       @map("ordered_qty") @db.Decimal(19, 4)
  receivedQty     Decimal       @default(0) @map("received_qty") @db.Decimal(19, 4)
  unitCost        Decimal       @map("unit_cost") @db.Decimal(19, 4)
  lineTotal       Decimal       @map("line_total") @db.Decimal(19, 4)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

model StockOpnameSession {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  sessionNumber  String            @map("session_number") @db.VarChar(50)
  status         OpnameStatus      @default(IN_PROGRESS)
  isBlindCount   Boolean           @default(false) @map("is_blind_count")
  totalVarianceValue Decimal       @default(0) @map("total_variance_value") @db.Decimal(19, 4)
  notes          String?
  approvedBy     String?           @map("approved_by") @db.VarChar(120)
  approvedAt     DateTime?         @map("approved_at") @db.Timestamptz()
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items          StockOpnameItem[]

  @@unique([tenantId, sessionNumber])
  @@map("stock_opname_sessions")
}

model StockOpnameItem {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opnameSessionId  String             @map("opname_session_id") @db.Uuid
  productId        String             @map("product_id") @db.Uuid
  systemQtySnapshot Decimal           @map("system_qty_snapshot") @db.Decimal(19, 4)
  physicalQty      Decimal            @map("physical_qty") @db.Decimal(19, 4)
  varianceQty      Decimal            @map("variance_qty") @db.Decimal(19, 4)
  unitCostSnapshot Decimal            @map("unit_cost_snapshot") @db.Decimal(19, 4)
  varianceValue    Decimal            @map("variance_value") @db.Decimal(19, 4)
  reasonCode       String?            @map("reason_code") @db.VarChar(30)

  session          StockOpnameSession @relation(fields: [opnameSessionId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_opname_items")
}

model BoardingRoom {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  roomNumber   String             @map("room_number") @db.VarChar(30)
  roomType     String             @map("room_type") @db.VarChar(60)
  monthlyPrice Decimal            @map("monthly_price") @db.Decimal(19, 4)
  annualPrice  Decimal            @default(0) @map("annual_price") @db.Decimal(19, 4)
  status        BoardingRoomStatus @default(AVAILABLE)
  showOnLanding Boolean            @default(true) @map("show_on_landing")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenants      BoardingTenant[]
  invoices     BoardingInvoice[]

  @@unique([tenantId, roomNumber])
  @@index([tenantId, showOnLanding, status], map: "idx_boarding_rooms_tenant_landing_status")
  @@map("boarding_rooms")
}

model BoardingTenant {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  roomId           String?           @map("room_id") @db.Uuid
  fullName         String            @map("full_name") @db.VarChar(150)
  nikKtp           String            @map("nik_ktp") @db.VarChar(20)
  phoneWa          String            @map("phone_wa") @db.VarChar(30)
  emergencyContact String?           @map("emergency_contact") @db.VarChar(120)
  checkInDate      DateTime          @map("check_in_date") @db.Date
  depositAmount    Decimal           @default(0) @map("deposit_amount") @db.Decimal(19, 4)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room             BoardingRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  invoices         BoardingInvoice[]

  @@map("boarding_tenants")
}

model BoardingInvoice {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  roomId          String         @map("room_id") @db.Uuid
  boardingTenantId String        @map("boarding_tenant_id") @db.Uuid
  periodMonth     String         @map("period_month") @db.VarChar(7)
  rentAmount      Decimal        @map("rent_amount") @db.Decimal(19, 4)
  utilityFee      Decimal        @default(0) @map("utility_fee") @db.Decimal(19, 4)
  lateFee         Decimal        @default(0) @map("late_fee") @db.Decimal(19, 4)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(19, 4)
  pph42Amount     Decimal        @default(0) @map("pph_4_2_amount") @db.Decimal(19, 4)
  paymentStatus   String         @default("UNPAID") @map("payment_status") @db.VarChar(20)
  paidAt          DateTime?      @map("paid_at") @db.Timestamptz()
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room            BoardingRoom         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  boardingTenant  BoardingTenant       @relation(fields: [boardingTenantId], references: [id], onDelete: Restrict)
  paymentTxns     PaymentTransaction[]

  @@map("boarding_invoices")
}

model AgroBatch {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  name             String           @db.VarChar(150)
  batchKind        AgroBatchKind    @map("batch_kind")
  startDate        DateTime         @map("start_date") @db.Date
  initialQty       Decimal          @map("initial_qty") @db.Decimal(19, 4)
  mortalityQty     Decimal          @default(0) @map("mortality_qty") @db.Decimal(19, 4)
  status           AgroBatchStatus  @default(ACTIVE)
  accumulatedCost  Decimal          @default(0) @map("accumulated_cost") @db.Decimal(19, 4)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usages           AgroBatchUsage[]
  harvests         AgroHarvest[]

  @@map("agro_batches")
}

model AgroBatchUsage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agroBatchId String    @map("agro_batch_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  usageCategory String  @map("usage_category") @db.VarChar(30)
  description String    @db.VarChar(180)
  qtyUsed     Decimal   @map("qty_used") @db.Decimal(19, 4)
  unitCost    Decimal   @map("unit_cost") @db.Decimal(19, 4)
  totalCost   Decimal   @map("total_cost") @db.Decimal(19, 4)
  usageDate   DateTime  @map("usage_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  batch       AgroBatch @relation(fields: [agroBatchId], references: [id], onDelete: Cascade)

  @@map("agro_batch_usages")
}

model AgroHarvest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agroBatchId     String    @map("agro_batch_id") @db.Uuid
  targetProductId String    @map("target_product_id") @db.Uuid
  harvestDate     DateTime  @map("harvest_date") @db.Date
